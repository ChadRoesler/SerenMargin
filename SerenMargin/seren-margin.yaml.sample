# seren-margin.yaml - SerenMargin config (the friend-to-friend version)
#
# Lives at ~/seren-margin/seren-margin.yaml. Same shape and location convention
# as SerenMemory's seren-memory.yaml - learn one service, you know them all. Set
# SEREN_MARGIN_CONFIG to override the location, or pass --config / -c on the
# command line (highest priority).
#
# Precedence (highest wins): env vars > this file > built-in defaults.
# Everything here is OPTIONAL - missing keys just use the defaults shown below.
# Bad values are ignored (logged to stderr, fall back to the default), and a
# malformed file falls back wholesale rather than crashing the service.
#
# The file is split into namespaced sections, lego-style. Each piece of the
# Seren stack reads its own section and ignores the others:
#   server:    <- this file's settings (what SerenMargin itself reads)
#   tools:     <- reserved for the future plug-and-play MCP tool layer

server:
  # Where sqlite lives. ~ is expanded.
  # Default: ~/.seren-margin/notes.db
  # db_path: ~/.seren-margin/notes.db

  # Bind address. Localhost-only by default because private notes shouldn't be
  # on a network without auth in front. (SerenMemory defaults to 0.0.0.0 for
  # the cluster; Margin deliberately does NOT.)
  #
  # Installing the [mcp] extra does not change this. Mounting an MCP endpoint
  # widens the TRANSPORT, not the LISTENER - /mcp is reachable exactly as far
  # as this host setting says it is. Widen at your own risk, on purpose.
  # Default: 127.0.0.1
  # host: 127.0.0.1

  # Listen port.
  # Default: 7421
  # port: 7421

  # NOTE: `notes_days` used to live here. It's GONE - it configured an
  # auto-expiry sweep that was removed when the lifecycle was (no pin, no
  # expiry, no done-state; notes live until retracted). The key outlived the
  # feature and read like a promise the service wasn't keeping. If you have it
  # in an existing config, it's ignored with a log line - safe to delete.


# ── MCP knobs (env only, no YAML block yet) ─────────────────────────────────
#
# With `pip install 'seren-margin[mcp]'` the service mounts a real MCP endpoint
# at /mcp on this same port. Tuned by environment variable, not by this file,
# so the systemd/NSSM unit is the single place transport config lives:
#
#   SEREN_MARGIN_MCP_MOUNT            mount path       (default: /mcp)
#   SEREN_MARGIN_MCP_ALLOWED_HOSTS    DNS-rebinding allowlist, comma-separated
#                                     (default: unset = host check OFF)
#   SEREN_MARGIN_MCP_ALLOWED_ORIGINS  optional, derived from HOSTS if omitted
#
# Without the extra installed, the service starts in HTTP-only mode and says so
# in the log. Nothing else changes.


# Reserved for the future plug-and-play MCP tool layer. SerenMargin itself
# ignores this block entirely. Schema will mirror McpConfig's open shape:
#   tools:
#     <tool_name>:
#       <key>: <value>
#
# Example (illustrative - not active until the plug-and-play registry ships):
# tools:
#   note_to_self:
#     max_content_chars: 2048
#     allowed_kinds: ["reminder", "observation", "question"]

# ── Update checking ───────────────────────────────────────────────────
#
# Asks the package index whether a newer seren-margin exists, and reports it on
# GET /. Purely informational - the service never upgrades itself. Applying
# an update is `pip install -U seren-margin` plus a restart, which belongs to your
# service supervisor (systemd, NSSM), not to this process.
#
# Enabled here by default, but it only DOES anything if the checking code is
# installed:  pip install 'seren-margin[updates]'
# Without that you get status="unavailable" plus a reason - never a quiet
# "you're up to date" from something that never actually looked.
#
# The result is cached for check_interval_hours and the lookup never happens
# in the request path, so the route stays fast.
updates:
  enabled: true
  check_interval_hours: 6      # cached; never checked per-request
  allow_prerelease: false      # true would offer you e.g. 2.0.0rc1
  # index_url: "https://pypi.org/pypi/{distribution}/json"   # private index?
